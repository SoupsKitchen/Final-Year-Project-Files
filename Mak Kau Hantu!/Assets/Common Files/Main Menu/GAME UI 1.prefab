  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jangan takut.\r\n\r\nBukan dia yang jahat.\r\nAyu... dia isteri yang kehilangan
    segalanya. Kandungan demi kandungan gugur. Kali terakhir, dia siapkan bilik bayi
    penuh harapan. Tapi takdir tak menyebelahi. Dia dan anaknya pergi semasa bersalin,
    tanpa sempat dibawa ke hospital. Suaminya lambat tiba.\r\n\nMereka ditanam di
    belakang rumah, tanpa upacara, tanpa doktor. Sejak tu, dia tak tenang.\r\nKadang
    malam, dengar tangisan. Kadang, dia berjalan di jalan lama sambil mendukung bayi.\r\nKalau
    kau nak bantu, carilah lampin, selendang, patung mainan bayi dan letakkanlah
    di tempat dia menghembus nafas terakhir.\r\nBiar dia tahu, dia masih diingati.\r\n\u2014
    Pak Mail"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 13bd5a0b25e4a0b48a956666ecf9c2bd, type: 2}
  m_sharedMaterial: {fileID: 6826032878461751634, guid: 13bd5a0b25e4a0b48a956666ecf9c2bd,
